# terraform/modules/iam/alb-controller-policy.json
#
# Download the official AWS Load Balancer Controller IAM policy before running
# terraform apply. This file is maintained by AWS and updated with each release.
#
# Run this command from the terraform/modules/iam/ directory:
#
#   curl -o alb-controller-policy.json \
#     https://raw.githubusercontent.com/kubernetes-sigs/aws-load-balancer-controller/main/docs/install/iam_policy.json
#
# Then commit the downloaded file to your repo.
# Do NOT replace this file with a placeholder — terraform will fail to parse it.
